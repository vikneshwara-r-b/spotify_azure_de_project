# Environment Variables for Databricks Asset Bundle
# Copy this file to .env and update with your values

# ============================================================================
# Databricks Workspace URL (REQUIRED)
# ============================================================================
# Get from Terraform: cd ../../infra && terraform output -raw databricks_workspace_url
# Then prepend with https://
DATABRICKS_HOST="https://adb-xxxxx.azuredatabricks.net"

# ============================================================================
# User Email (OPTIONAL - for production permissions)
# ============================================================================
# Used for prod target permissions
USER_EMAIL="your-email@domain.com"

# ============================================================================
# ADLS Storage Container Name (REQUIRED)
# ============================================================================
# The ADLS Gen2 storage container name where data is stored
ADLS_STORAGE_CONTAINER_NAME="<ADLS Gen2 Storage Container Name>"

# ============================================================================
# ADF Service Principal ID (OPTIONAL - for bundle permissions)
# ============================================================================
# ADF Managed Identity Application ID that needs access to deployed bundles
# Get from Terraform: cd ../../infra && terraform output -raw adf_managed_identity_application_id
ADF_SERVICE_PRINCIPAL_ID="677878f6-17a1-41ad-b8bd-aef1efa9f1dd"

# ============================================================================
# How to Use
# ============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Update values above with actual values from your Azure environment
# 3. Load variables: export $(grep -v '^#' .env | xargs)
# 4. Deploy: databricks bundle deploy -t dev
#
# Alternative: Use --var flags instead of environment variables
# databricks bundle deploy -t dev \
#   --var="user_email=your-email@company.com" \
#   --var="adls_storage_container_name=adlsspotifyv1" \
#   --var="adf_service_principal_id=677878f6-17a1-41ad-b8bd-aef1efa9f1dd"
