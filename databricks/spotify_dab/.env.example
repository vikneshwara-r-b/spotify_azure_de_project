# Environment Variables for Databricks Asset Bundle
# Copy this file to .env and update with your values

# ============================================================================
# Databricks Workspace URL (REQUIRED)
# ============================================================================
# Get from Terraform: cd ../../infra && terraform output -raw databricks_workspace_url
# Then prepend with https://
DATABRICKS_HOST="https://adb-xxxxx.azuredatabricks.net"

# ============================================================================
# User Email (OPTIONAL - for production permissions)
# ============================================================================
# Used for prod target permissions
USER_EMAIL="your-email@domain.com"

# ============================================================================
# How to Use
# ============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Update values above
# 3. Load variables: source .env
# 4. Deploy: databricks bundle deploy -t dev
