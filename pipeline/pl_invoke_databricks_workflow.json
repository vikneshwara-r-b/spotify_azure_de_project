{
	"name": "pl_invoke_databricks_workflow",
	"properties": {
		"activities": [
			{
				"name": "Loop each secret key",
				"type": "ForEach",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@pipeline().parameters.input_secret_keys",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Fetch Secret KV Pair",
							"type": "WebActivity",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": true,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"method": "GET",
								"url": {
									"value": "@{pipeline().globalParameters.key_vault_url}secrets/@{item()}?api-version=7.0",
									"type": "Expression"
								},
								"authentication": {
									"type": "MSI",
									"resource": "https://vault.azure.net/"
								}
							}
						},
						{
							"name": "Append secret key and value",
							"type": "AppendVariable",
							"dependsOn": [
								{
									"activity": "Fetch Secret KV Pair",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"variableName": "secret_kv_pair_list",
								"value": {
									"value": "@concat('\"', item(), '\": \"', activity('Fetch Secret KV Pair').output.value, '\"')",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "Set secrets map",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Loop each secret key",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": true,
					"secureInput": true
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "secrets_map",
					"value": {
						"value": "@concat('{', join(variables('secret_kv_pair_list'), ','), '}')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Invoke databricks workflow job",
				"type": "DatabricksJob",
				"dependsOn": [
					{
						"activity": "Set secrets map",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"jobId": {
						"value": "@pipeline().globalParameters.databricks_workflow_job_id",
						"type": "Expression"
					}
				},
				"linkedServiceName": {
					"referenceName": "ls_azure_databricks_connection",
					"type": "LinkedServiceReference",
					"parameters": {
						"databricks_workspace_url": {
							"value": "@string(json(variables('secrets_map'))['databricks-workspace-url'])",
							"type": "Expression"
						},
						"databricks_workspace_resource_id": {
							"value": "@string(json(variables('secrets_map'))['databricks-workspace-resource-id'])",
							"type": "Expression"
						}
					}
				}
			}
		],
		"parameters": {
			"input_secret_keys": {
				"type": "array",
				"defaultValue": [
					"databricks-workspace-url",
					"databricks-workspace-resource-id"
				]
			}
		},
		"variables": {
			"secrets_map": {
				"type": "String",
				"defaultValue": "{}"
			},
			"secret_kv_pair_list": {
				"type": "Array"
			}
		},
		"annotations": []
	}
}